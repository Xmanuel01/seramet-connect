{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "bridge": "node local-print-bridge/server.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:database": "vitest run src/server/pass-5-production-foundation.test.ts",
    "test:concurrency": "vitest run src/server/pass-5-production-foundation.test.ts src/guest/pass-11-digital-guest.test.ts src/enterprise/pass-12-enterprise.test.ts -t \"concurrent|simultaneous|duplicate|idempotent|double|once\"",
    "test:offline": "vitest run src/server/pass-5-production-foundation.test.ts -t offline",
    "test:load": "vitest run src/server/pass-5-load.test.ts",
    "test:pass6": "vitest run src/inventory/pass-6-inventory-intelligence.test.ts",
    "test:pass7": "vitest run src/management/pass-7-management-intelligence.test.ts",
    "test:pass7-load": "vitest run --reporter=verbose src/management/pass-7-load.test.ts",
    "test:pass8": "vitest run src/onboarding/pass-8-commercial-productization.test.ts",
    "test:pass8-load": "vitest run --reporter=verbose src/onboarding/pass-8-load.test.ts",
    "test:pass9": "vitest run src/intelligence/pass-9-intelligence.test.ts",
    "test:pass9-load": "vitest run --reporter=verbose src/intelligence/pass-9-load.test.ts",
    "test:pass11": "vitest run src/guest/pass-11-digital-guest.test.ts",
    "test:pass11-load": "vitest run --reporter=verbose src/guest/pass-11-load.test.ts",
    "test:pass12": "vitest run src/enterprise/pass-12-enterprise.test.ts",
    "test:pass12-load": "vitest run --reporter=verbose src/enterprise/pass-12-load.test.ts",
    "test:commercial": "vitest run src/server/commercial-launch.test.ts src/server/postgres-migration.test.ts",
    "test:identity": "vitest run src/server/identity-device-branch-hardening.test.ts",
    "migrate:postgres": "vite-node scripts/migrate-postgres.ts",
    "audit:bundle": "node scripts/audit-production-bundle.mjs",
    "deploy:staging": "npm run build && node scripts/render-cloudflare-config.mjs staging && npx --yes wrangler@4.15.2 deploy --config .seramet/wrangler.generated.json",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
