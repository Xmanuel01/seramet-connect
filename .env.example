# Explicit local-development settings. Production and staging must use managed bindings.
SERAMET_ENVIRONMENT=development
SERAMET_ENABLE_DEV_AUTH=false
SERAMET_REQUIRE_BEARER=true

# Supabase Auth is called through the Seramet server. Never place service-role,
# database, or provider credentials in VITE_* variables.
SERAMET_IDENTITY_PROVIDER=supabase
SERAMET_SUPABASE_URL=https://your-project-ref.supabase.co
SERAMET_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SERAMET_PUBLIC_ORIGIN=http://127.0.0.1:5173

# Deployment migrations only. Keep this in CI secrets, never Worker variables.
# SERAMET_POSTGRES_URL=postgresql://...
